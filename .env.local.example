# Gemini API Key (server-side only)
GEMINI_API_KEY=

# OpenAI API key (server-side only). Optional: required only for the
# "GPT-Live (OpenAI)" voice model. GPT-Live bills $0.05/min of audio plus the
# delegated Responses backend's tokens, and creating a WebRTC session bills
# 15 s of initialization that is credited back once the session runs.
OPENAI_API_KEY=

# Firebase Client Config (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Admin (server-side only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cookie Signing Secrets
COOKIE_SECRET_CURRENT=
COOKIE_SECRET_PREVIOUS=

# Simli avatar (server-side only). Optional: without SIMLI_API_KEY the
# "Video partner" toggle degrades to audio-only.
SIMLI_API_KEY=
# Optional: allow a custom (non-preset) face id from src/config/avatars.ts
SIMLI_DEFAULT_FACE_ID=

# HeyGen LiveAvatar (server-side only). Optional second avatar vendor; without
# LIVEAVATAR_API_KEY the LiveAvatar option degrades to audio-only. Note the
# free tier is 10 minutes/month with a 5-minute idle timeout.
LIVEAVATAR_API_KEY=
# Optional: allow a custom (non-preset) avatar id from src/config/avatars.ts
LIVEAVATAR_DEFAULT_AVATAR_ID=
